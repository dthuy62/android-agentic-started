#!/usr/bin/env bash
# Fast checks before a commit: ktlint and detekt, only when Kotlin or their config is staged.
# Compiling and tests are left to CI. Skip once with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACM)"
if ! grep -qE '\.(kt|kts)$|^\.editorconfig$|^config/detekt/' <<< "$staged"; then
  exit 0
fi

echo "pre-commit: ktlintCheck detekt"
if ! ./gradlew -q ktlintCheck detekt; then
  echo
  echo "pre-commit failed. Fix formatting with: ./gradlew ktlintFormat"
  exit 1
fi
